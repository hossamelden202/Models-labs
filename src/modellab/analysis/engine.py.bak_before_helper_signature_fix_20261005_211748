def _detection_box_area(box):
    x1, y1, x2, y2 = [float(v) for v in box]
    return max(0.0, x2 - x1) * max(0.0, y2 - y1)


def _detection_box_size(area):
    if area < 0.05:
        return "small"
    if area < 0.20:
        return "medium"
    return "large"


def _detection_percentile_bucket(value):
    value = float(value)

    if value < 0.25:
        return "low"
    if value < 0.60:
        return "medium"
    if value < 0.90:
        return "high"
    return "very_high"


